# ---------- MongoDB (internal only, never published) ----------
MONGO_USER=finance
MONGO_PASSWORD=change-me-long-random          # openssl rand -hex 24
# For running services outside Docker (pnpm dev:*), point at a local MongoDB:
MONGODB_URI=mongodb://finance:change-me-long-random@127.0.0.1:27017/finance?authSource=admin

# ---------- Dashboard ----------
DASHBOARD_PASSWORD=change-me-strong-password  # min 10 chars
SESSION_SECRET=                               # openssl rand -hex 32
WEB_PORT=3100                                 # host port bound to 127.0.0.1

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=                           # from @BotFather
TELEGRAM_ALLOWED_USER_IDS=                    # your numeric user id(s), comma separated (ask @userinfobot)
TELEGRAM_MODE=webhook                         # webhook (production) | polling (local dev, no tunnel needed)
TELEGRAM_WEBHOOK_SECRET=                      # openssl rand -hex 32  (A-Z a-z 0-9 _ - only)
TELEGRAM_WEBHOOK_URL=https://finance.example.com/api/v1/webhooks/telegram
TELEGRAM_REPORT_CHAT_ID=                      # optional; otherwise the chat that sent /start

# ---------- Claude ----------
ANTHROPIC_API_KEY=                            # optional; reports work without it (no AI section)
ANTHROPIC_MODEL=claude-opus-5-5

# ---------- MCP server ----------
MCP_AUTH_TOKEN=                               # openssl rand -hex 32  (>= 32 chars)
MCP_ALLOWED_ORIGINS=                          # leave empty unless a browser client needs access
MCP_PORT_HOST=8082

# ---------- Cloudflare Tunnel (docker compose --profile tunnel) ----------
CLOUDFLARE_TUNNEL_TOKEN=
